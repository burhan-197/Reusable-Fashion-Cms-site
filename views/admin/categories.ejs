<%- include('partials/head',{title:'Categories'}) %><%- include('partials/sidebar') %><main class="admin-main"><div class="admin-top"><p class="kicker">Catalog</p><h1>Categories</h1><p>Simple flat categories only.</p></div><% if(error){%><div class="alert"><%= error %></div><%}%><div class="split"><form class="panel form-stack" method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Add category</h2><label>Name<input name="name" maxlength="80" required></label><button class="primary" type="submit">Add category</button></form><div class="panel"><h2>Existing categories</h2><div class="category-list"><% if(categories.length){categories.forEach(c=>{%><div class="category-row"><form method="post" action="/admin/categories/<%= c._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= c.name %>" required maxlength="80"><button class="secondary" type="submit">Save</button></form><span><%= c.productCount %> products</span><form method="post" action="/admin/categories/<%= c._id %>/delete" onsubmit="return confirm('Delete this category?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">Delete</button></form></div><%})}else{%><p class="muted-text">No categories yet.</p><%}%></div></div></div></main><%- include('partials/footer') %>
