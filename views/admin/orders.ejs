<%- include('partials/head',{title:'Orders'}) %><%- include('partials/sidebar') %><main class="admin-main"><div class="admin-top"><p class="kicker">Fulfilment</p><h1>Orders</h1><p>Guest COD/manual orders only.</p></div><div class="panel table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% if(orders.length){orders.forEach(o=>{%><tr><td><strong><%= o.orderNumber %></strong><br><small><%= new Date(o.createdAt).toLocaleString() %></small></td><td><%= o.customerName %><br><small><%= o.phone %></small></td><td><%= formatMoney(o.total) %></td><td><%= o.paymentMethod==='cod'?'COD':'Manual' %></td><td><span class="status <%= o.status %>"><%= o.status %></span></td><td><a href="/admin/orders/<%= o._id %>">View</a></td></tr><%})}else{%><tr><td colspan="6" class="empty-cell">No orders yet.</td></tr><%}%></tbody></table></div></main><%- include('partials/footer') %>
