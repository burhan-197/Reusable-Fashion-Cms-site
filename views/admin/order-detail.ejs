<%- include('partials/head',{title:'Order '+order.orderNumber}) %><%- include('partials/sidebar') %><main class="admin-main"><div class="admin-top row"><div><p class="kicker">Order</p><h1><%= order.orderNumber %></h1></div><a class="secondary linkbtn" href="/admin/orders">← Back</a></div><% if(error){%><div class="alert"><%= error %></div><%}%><div class="split order-split"><section class="panel"><h2>Items</h2><% order.items.forEach(item=>{%><div class="order-line"><span><%= item.name %> × <%= item.qty %></span><strong><%= formatMoney(item.price*item.qty) %></strong></div><%})%><div class="order-line total"><span>Total</span><strong><%= formatMoney(order.total) %></strong></div></section><section class="panel form-stack"><h2>Customer</h2><p><strong><%= order.customerName %></strong><br><%= order.phone %><% if(order.email){%><br><%= order.email %><%}%></p><p><%= order.address %><br><%= order.city %> <%= order.postalCode %></p><% if(order.notes){%><p><strong>Note:</strong> <%= order.notes %></p><%}%><p><strong>Payment:</strong> <%= order.paymentMethod==='cod'?'Cash on delivery':'Manual payment' %></p><form method="post" action="/admin/orders/<%= order._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Order status<select name="status"><% ['pending','processing','shipped','delivered','cancelled'].forEach(s=>{%><option value="<%= s %>" <%= order.status===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><%})%></select></label><button class="primary" type="submit">Update status</button></form></section></div></main><%- include('partials/footer') %>
