<%- include('partials/head',{title:'First Admin Setup'}) %><main class="auth-wrap"><form class="auth-card" method="post" action="/admin/setup"><div class="admin-brand center-brand">FORME <small>Lite CMS</small></div><h1>Create administrator</h1><p>This page only works until the first admin account is created.</p><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Username<input name="username" minlength="3" maxlength="60" required></label><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" required></label><% if(error){%><div class="alert"><%= error %></div><%}%><button class="primary" type="submit">Create admin</button></form></main><%- include('partials/footer') %>
