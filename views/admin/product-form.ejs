<%- include('partials/head',{title:mode==='create'?'Add Product':'Edit Product'}) %><%- include('partials/sidebar') %><main class="admin-main"><div class="admin-top"><p class="kicker">Catalog</p><h1><%= mode==='create'?'Add product':'Edit product' %></h1><p>Lite products use one price and one stock quantity. Advanced variants are not included.</p></div><% if(error){%><div class="alert"><%= error %></div><%}%><% if(typeof created!=='undefined'||typeof saved!=='undefined'){} %><form class="panel form-stack" method="post" enctype="multipart/form-data" action="<%= mode==='create'?'/admin/products':'/admin/products/'+product._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Product name<input name="name" maxlength="120" required value="<%= values.name || '' %>"></label><label>Description<textarea name="description" maxlength="5000" rows="7" required><%= values.description || '' %></textarea></label><div class="form-two"><label>Price<input type="number" name="price" min="0.01" step="0.01" required value="<%= values.price ?? '' %>"></label><label>Stock quantity<input type="number" name="stock" min="0" step="1" required value="<%= values.stock ?? '' %>"></label></div><label>Category<select name="category" required><option value="">Select category</option><% categories.forEach(c=>{%><option value="<%= c._id %>" <%= String(values.category?._id||values.category||'')===String(c._id)?'selected':'' %>><%= c.name %></option><%})%></select></label><% if(mode==='edit'&&product.images?.length){%><div><span class="label-text">Current images</span><div class="image-grid"><% product.images.forEach(img=>{%><label class="image-tile"><img src="<%= img %>" alt=""><span><input type="checkbox" name="removeImages" value="<%= img %>"> Remove</span></label><%})%></div></div><%}%><label>Product images <span class="muted-text">JPG, PNG or WebP · max 4 total</span><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple></label><div class="actions"><button class="primary" type="submit"><%= mode==='create'?'Create product':'Save changes' %></button><a class="secondary linkbtn" href="/admin/products">Cancel</a></div></form></main><%- include('partials/footer') %>
