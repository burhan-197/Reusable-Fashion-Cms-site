<%- include('partials/head',{title:'Products'}) %><%- include('partials/sidebar') %><main class="admin-main"><div class="admin-top row"><div><p class="kicker">Catalog</p><h1>Products</h1></div><a class="primary linkbtn" href="/admin/products/new">+ Add product</a></div><div class="panel table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody><% if(products.length){products.forEach(p=>{%><tr><td><div class="product-cell"><% if(p.images?.[0]){%><img src="<%= p.images[0] %>" alt=""><%}%><strong><%= p.name %></strong></div></td><td><%= p.category?.name || '—' %></td><td><%= formatMoney(p.price) %></td><td><%= p.stock %></td><td class="row-actions"><a href="/admin/products/<%= p._id %>/edit">Edit</a><form method="post" action="/admin/products/<%= p._id %>/delete" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">Delete</button></form></td></tr><%})}else{%><tr><td colspan="5" class="empty-cell">No products yet.</td></tr><%}%></tbody></table></div></main><%- include('partials/footer') %>
