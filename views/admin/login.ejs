<%- include('partials/head',{title:'Admin Login'}) %><main class="auth-wrap"><form class="auth-card" method="post" action="/admin/login"><div class="admin-brand center-brand">FORME <small>Lite CMS</small></div><h1>Admin login</h1><p>Sign in to manage products, categories and orders.</p><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Username<input name="username" autocomplete="username" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><% if(error){%><div class="alert"><%= error %></div><%}%><button class="primary" type="submit">Sign in</button></form></main><%- include('partials/footer') %>
