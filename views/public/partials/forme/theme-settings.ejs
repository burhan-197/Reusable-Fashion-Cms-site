<%
  const a = settings.appearance || {};
  const c = a.colors || {};
  const t = a.typography || {};
%>
<link rel="stylesheet" href="/css/forme/polish.css">
<style id="forme-lite-theme">
  :root {
    --f-primary: <%= c.primary || '#20221f' %>;
    --f-secondary: <%= c.secondary || '#414840' %>;
    --f-accent: <%= c.accent || '#793c30' %>;
    --f-light-background: <%= c.pageBackground || '#fcfcfa' %>;
    --f-light-surface: <%= c.sectionBackground || '#f0f1ed' %>;
    --f-light-raised: <%= c.cardBackground || '#ffffff' %>;
    --f-light-text: <%= c.mainText || '#20221f' %>;
    --f-light-muted: <%= c.secondaryText || '#63675f' %>;
    --f-light-border: <%= c.border || '#d5d8d0' %>;
    --f-button-background: <%= c.buttonBackground || '#20221f' %>;
    --f-button-text: <%= c.buttonText || '#fcfcfa' %>;
    --f-font-display: <%= t.headingFont || 'Cormorant Garamond, Georgia, serif' %>;
    --f-font-editorial: Georgia, 'Times New Roman', serif;
    --f-font-body: <%= t.bodyFont || 'Jost, Arial, sans-serif' %>;
    --f-button-radius: 4px;
    --f-card-radius: 4px;
    --f-radius: 4px;
    --f-content-width: 1440px;
    --f-section-space: clamp(4.5rem, 8vw, 8rem);
    --f-grid-gap: clamp(.8rem, 1.8vw, 1.75rem);
    --f-product-ratio: 4 / 5;
  }
  html { font-size: 16px; }
  .f-header { background:#fcfcfa; color:#20221f; }
  .f-footer { background:#20251f; color:#f6f7f0; }
</style>
